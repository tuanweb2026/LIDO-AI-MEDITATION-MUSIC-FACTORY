# LIDO AI Meditation Music Factory - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN VALUES FOR LOCAL PRODUCTION USE

# YouTube Data API v3 Key (Leave empty to default to Offline Synthetic Fixture Mode)
YOUTUBE_API_KEY=

# Local SQLite Configuration
LIDO_DB_PATH=data/lido_factory.db

# Execution Mode: DRY_RUN | PRODUCTION
EXECUTION_MODE=DRY_RUN
